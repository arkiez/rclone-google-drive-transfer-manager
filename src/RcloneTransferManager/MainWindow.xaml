<Window x:Class="RcloneTransferManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rclone Transfer Manager"
        Width="900" Height="520" MinWidth="700" MinHeight="470"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" Background="{StaticResource NeutralSurfaceBrush}" CornerRadius="7" Padding="6">
                        <Path Data="{StaticResource CloudIcon}" Fill="{StaticResource PrimaryBrush}"
                              Stretch="Uniform"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0">
                        <TextBlock Text="Rclone Transfer Manager" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="Google Drive and public link sources"
                                   Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}" Click="Accounts_Click"
                            AutomationProperties.Name="Open cloud accounts" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource CloudIcon}" Style="{StaticResource ButtonIcon}"/>
                            <TextBlock Text="Accounts"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Click="About_Click"
                            AutomationProperties.Name="Open about dialog">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource InfoIcon}" Style="{StaticResource ButtonIcon}"/>
                            <TextBlock Text="About"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Width="760" HorizontalAlignment="Center" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                            <Path Data="{StaticResource CopyIcon}" Style="{StaticResource SectionIcon}" Margin="0,0,8,0"/>
                            <StackPanel>
                                <TextBlock Text="Transfer setup" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="Paste a Google Drive or public file source; choose Google Drive or Local for destination."
                                           Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <Grid Margin="0,0,0,6" MinHeight="34">
                                    <TextBlock Text="Source" Foreground="{StaticResource MutedBrush}"
                                               FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid>
                                    <TextBox x:Name="SourceBox"
                                             Style="{StaticResource RoundedInputTextBox}"
                                             Padding="9,7,36,7"
                                             TextChanged="LocationBox_TextChanged"
                                             AutomationProperties.Name="Source cloud link"
                                             AutomationProperties.HelpText="Paste a Google Drive file or folder link, or a public direct file link"/>
                                    <TextBlock x:Name="SourcePlaceholder"
                                               Style="{StaticResource WatermarkTextStyle}"
                                               Margin="10,0,36,0"
                                               Text="Paste a Google Drive file or folder link, or a public direct file link"/>
                                    <Button x:Name="SourceClearButton"
                                            Style="{StaticResource InputClearButton}"
                                            Content="×" Visibility="Collapsed"
                                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                                            Click="ClearSource_Click" AutomationProperties.Name="Clear source"/>
                                </Grid>
                                <TextBlock x:Name="SourceStatus" Foreground="{StaticResource MutedBrush}"
                                           FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Destination" Foreground="{StaticResource MutedBrush}"
                                               FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <RadioButton x:Name="DestinationCloudRadio"
                                                     GroupName="DestinationLocationMode"
                                                     Style="{StaticResource SegmentedRadioButton}"
                                                     AutomationProperties.Name="Use a cloud destination">
                                            <TextBlock Text="Cloud"/>
                                        </RadioButton>
                                        <RadioButton x:Name="DestinationLocalRadio"
                                                     GroupName="DestinationLocationMode"
                                                     Style="{StaticResource SegmentedRadioButton}"
                                                     IsChecked="True" Margin="-1,0,0,0"
                                                     AutomationProperties.Name="Use a local destination">
                                            <TextBlock Text="Local"/>
                                        </RadioButton>
                                    </StackPanel>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0">
                                        <TextBox x:Name="DestinationBox"
                                                 Style="{StaticResource RoundedInputTextBox}"
                                                 Padding="9,7,36,7"
                                                 TextChanged="LocationBox_TextChanged"
                                                 AutomationProperties.Name="Destination local folder"
                                                 AutomationProperties.HelpText="Enter a local folder path or click Browse"/>
                                        <TextBlock x:Name="DestinationPlaceholder"
                                                   Style="{StaticResource WatermarkTextStyle}"
                                                   Margin="10,0,36,0"
                                                   Text="Enter a local folder path or click Browse"/>
                                        <Button x:Name="DestinationClearButton"
                                                Style="{StaticResource InputClearButton}"
                                                Content="×" Visibility="Collapsed"
                                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                                                Click="ClearDestination_Click" AutomationProperties.Name="Clear destination"/>
                                    </Grid>
                                    <Button x:Name="BrowseDestinationButton" Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                            Click="BrowseDestination_Click" Margin="8,0,0,0"
                                            AutomationProperties.Name="Browse for destination local folder">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource FolderIcon}" Style="{StaticResource ButtonIcon}"/>
                                            <TextBlock Text="Browse"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock x:Name="DestinationStatus" Foreground="{StaticResource MutedBrush}"
                                           FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Mode" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <Border Background="{StaticResource NeutralSurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="4">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="CopyRadio" GroupName="TransferMode" IsChecked="True"
                                                     Style="{StaticResource SegmentedRadioButton}"
                                                     AutomationProperties.Name="Copy mode">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource CopyIcon}"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                      Width="14" Height="14" Stretch="Uniform" Margin="0,0,5,0"/>
                                                <TextBlock Text="Copy"/>
                                            </StackPanel>
                                        </RadioButton>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="Copy never deletes destination files."
                                       Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap"
                                       VerticalAlignment="Bottom" Margin="16,0,16,3"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Button Style="{StaticResource PrimaryButton}" Click="StartTransfer_Click"
                                        AutomationProperties.Name="Start transfer">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource PlayIcon}" Style="{StaticResource ButtonIcon}"/>
                                        <TextBlock Text="Start"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Background="{StaticResource NeutralSurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="7" Padding="12" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource WarningIcon}" Fill="{StaticResource PrimaryBrush}"
                              Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"
                              VerticalAlignment="Top"/>
                        <TextBlock Text="Public file links to Local do not need login. Cloud folders use the connected account; shared read-only links cannot be destinations."
                                   Foreground="{StaticResource ForegroundBrush}" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="2" x:Name="ValidationText" Foreground="{StaticResource MutedBrush}"
                           FontSize="12" TextWrapping="Wrap" MinHeight="20"/>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="20,8">
            <Grid>
                <TextBlock Text="Copy mode only  |  Destination files are never deleted"
                           Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                <TextBlock x:Name="VersionText"
                           HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
            </Grid>
        </Border>
    </Grid>
</Window>
