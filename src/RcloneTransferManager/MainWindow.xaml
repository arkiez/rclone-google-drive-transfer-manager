<Window x:Class="RcloneTransferManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rclone Transfer Manager v1.1.0"
        Width="900" Height="660" MinWidth="700" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" Background="#EFF6FF" CornerRadius="7" Padding="6">
                        <Path Data="{StaticResource CloudIcon}" Fill="{StaticResource PrimaryBrush}"
                              Stretch="Uniform"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0">
                        <TextBlock Text="Rclone Transfer Manager" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="Local, Google Drive, and OneDrive transfers"
                                   Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}" Click="Accounts_Click"
                            AutomationProperties.Name="Open cloud accounts" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource CloudIcon}" Style="{StaticResource ButtonIcon}"/>
                            <TextBlock Text="Accounts"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Click="About_Click"
                            AutomationProperties.Name="Open about dialog">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource InfoIcon}" Style="{StaticResource ButtonIcon}"/>
                            <TextBlock Text="About"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Width="760" HorizontalAlignment="Center" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="260"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Saved job" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="SavedJobCombo" Grid.Column="0"
                                          SelectionChanged="SavedJobCombo_SelectionChanged"
                                          AutomationProperties.Name="Saved transfer jobs"/>
                                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                        Click="RefreshJobs_Click" Margin="8,0,0,0"
                                        AutomationProperties.Name="Refresh saved jobs">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource RefreshIcon}" Style="{StaticResource ButtonIcon}"/>
                                        <TextBlock Text="Refresh"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="Job name" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox x:Name="JobNameBox" AutomationProperties.Name="Job name"
                                     ToolTip="Example: Photos backup"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                            <Path Data="{StaticResource SyncIcon}" Style="{StaticResource SectionIcon}" Margin="0,0,8,0"/>
                            <StackPanel>
                                <TextBlock Text="Transfer setup" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="Paste a public file download link, cloud folder link, or local folder path."
                                           Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Source" Foreground="{StaticResource MutedBrush}"
                                           FontSize="12" FontWeight="Bold" Margin="0,0,0,5"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SourceBox" Grid.Column="0"
                                             TextChanged="LocationBox_TextChanged"
                                             AutomationProperties.Name="Source link or local folder path"
                                             ToolTip="Google Drive, OneDrive, or local folder path"/>
                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                            Click="BrowseSource_Click" Margin="8,0,0,0"
                                            AutomationProperties.Name="Browse for source local folder">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource FolderIcon}" Style="{StaticResource ButtonIcon}"/>
                                            <TextBlock Text="Browse"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock x:Name="SourceStatus" Foreground="{StaticResource MutedBrush}"
                                           FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Destination" Foreground="{StaticResource MutedBrush}"
                                           FontSize="12" FontWeight="Bold" Margin="0,0,0,5"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="DestinationBox" Grid.Column="0"
                                             TextChanged="LocationBox_TextChanged"
                                             AutomationProperties.Name="Destination link or local folder path"
                                             ToolTip="Google Drive, OneDrive, or local folder path"/>
                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                            Click="BrowseDestination_Click" Margin="8,0,0,0"
                                            AutomationProperties.Name="Browse for destination local folder">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource FolderIcon}" Style="{StaticResource ButtonIcon}"/>
                                            <TextBlock Text="Browse"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock x:Name="DestinationStatus" Foreground="{StaticResource MutedBrush}"
                                           FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Mode" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <Border Background="#F1F5FD" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="4">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="CopyRadio" GroupName="TransferMode" IsChecked="True"
                                                     AutomationProperties.Name="Copy mode">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource CopyIcon}" Fill="{StaticResource PrimaryBrush}"
                                                      Width="14" Height="14" Stretch="Uniform" Margin="0,0,5,0"/>
                                                <TextBlock Text="Copy"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="SyncRadio" GroupName="TransferMode"
                                                     AutomationProperties.Name="Sync mode">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource SyncIcon}" Fill="{StaticResource PrimaryBrush}"
                                                      Width="14" Height="14" Stretch="Uniform" Margin="0,0,5,0"/>
                                                <TextBlock Text="Sync"/>
                                            </StackPanel>
                                        </RadioButton>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="Copy never deletes destination files. Sync previews changes before applying them."
                                       Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap"
                                       VerticalAlignment="Bottom" Margin="16,0,16,3"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Button Style="{StaticResource SecondaryButton}" Click="SaveJob_Click"
                                        Margin="0,0,8,0" AutomationProperties.Name="Save current transfer job">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource SaveIcon}" Style="{StaticResource ButtonIcon}"/>
                                        <TextBlock Text="Save Job"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource PrimaryButton}" Click="StartTransfer_Click"
                                        AutomationProperties.Name="Start transfer">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource PlayIcon}" Style="{StaticResource ButtonIcon}"/>
                                        <TextBlock Text="Start"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"
                        CornerRadius="7" Padding="12" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource WarningIcon}" Fill="{StaticResource PrimaryBrush}"
                              Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"
                              VerticalAlignment="Top"/>
                        <TextBlock Text="Public file links to Local do not need login. Cloud folders use the connected account; shared read-only links cannot be destinations."
                                   Foreground="#1E3A8A" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="3" x:Name="ValidationText" Foreground="{StaticResource MutedBrush}"
                           FontSize="12" TextWrapping="Wrap" MinHeight="20"/>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="20,8">
            <Grid>
                <TextBlock Text="Copy is the safe default  |  Sync always previews changes"
                           Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                <TextBlock Text="v1.1.0  |  Arkie'z K. Khositkhanawut"
                           HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
            </Grid>
        </Border>
    </Grid>
</Window>
