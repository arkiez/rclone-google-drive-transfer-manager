<Window x:Class="RcloneTransferManager.Views.TransferMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transfer Monitor" Width="760" Height="580" MinWidth="620" MinHeight="480"
        WindowStartupLocation="CenterOwner" Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource PlayIcon}" Style="{StaticResource SectionIcon}" Margin="0,0,9,0"/>
                <StackPanel>
                    <TextBlock Text="Transfer Monitor" FontSize="20" FontWeight="Bold"/>
                    <TextBlock x:Name="JobText" Foreground="{StaticResource MutedBrush}" FontSize="11"
                               Margin="0,2,0,0"/>
                    <TextBlock x:Name="RouteText" Foreground="{StaticResource MutedBrush}" FontSize="11"
                               TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="ModeText" HorizontalAlignment="Right" VerticalAlignment="Top"
                       FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource PrimaryBrush}"/>
        </Grid>

        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <TextBlock x:Name="StatusText" Text="Starting..." FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PercentText" HorizontalAlignment="Right" Text="-"
                               FontSize="15" FontWeight="SemiBold"/>
                </Grid>
                <ProgressBar x:Name="TransferProgress" Height="10" Margin="0,10,0,10"
                             Minimum="0" Maximum="100" IsIndeterminate="True"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Transferred" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                        <TextBlock x:Name="TransferredText" Text="-" FontSize="12" FontWeight="SemiBold"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="Current file" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                        <TextBlock x:Name="CurrentFileText" Text="-" FontSize="12"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="12,0,0,0">
                        <TextBlock Text="ETA / rate" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                        <TextBlock x:Name="EtaText" Text="-" FontSize="12"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" Text="Activity log" FontWeight="SemiBold" FontSize="12"
                   Margin="0,0,0,6"/>
        <ListBox x:Name="LogList" Grid.Row="3" FontFamily="Consolas" FontSize="10"
                 BorderBrush="{StaticResource BorderBrush}" Background="White"/>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <TextBlock x:Name="DetailText" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                       FontSize="11" TextTrimming="CharacterEllipsis"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="PauseButton" Style="{StaticResource SecondaryButton}" Click="Pause_Click"
                        Margin="0,0,6,0" AutomationProperties.Name="Pause transfer">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource PauseIcon}" Style="{StaticResource ButtonIcon}"/>
                        <TextBlock Text="Pause"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ResumeButton" Style="{StaticResource SecondaryButton}" Click="Resume_Click"
                        Margin="0,0,6,0" IsEnabled="False" AutomationProperties.Name="Resume transfer">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource PlayIcon}" Style="{StaticResource ButtonIcon}"/>
                        <TextBlock Text="Resume"/>
                    </StackPanel>
                </Button>
                <Button x:Name="CancelButton" Style="{StaticResource DangerButton}" Click="Cancel_Click"
                        Margin="0,0,6,0" AutomationProperties.Name="Cancel transfer">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource CancelIcon}" Style="{StaticResource ButtonIcon}"/>
                        <TextBlock Text="Cancel"/>
                    </StackPanel>
                </Button>
                <Button x:Name="CloseButton" Style="{StaticResource SecondaryButton}" Click="Close_Click"
                        IsEnabled="False" AutomationProperties.Name="Close transfer monitor">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource CheckIcon}" Style="{StaticResource ButtonIcon}"/>
                        <TextBlock Text="Close"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
