<Window x:Class="RcloneTransferManager.Views.SyncPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review Sync Changes" Width="720" Height="560" MinWidth="580" MinHeight="430"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Path Data="{StaticResource SyncIcon}" Style="{StaticResource SectionIcon}" Margin="0,0,9,0"/>
            <StackPanel>
                <TextBlock Text="Review Sync Changes" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="Confirm the exact changes before Sync can delete destination files."
                           Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource WarningSurfaceBrush}" BorderBrush="{StaticResource WarningBorderBrush}" BorderThickness="1"
                CornerRadius="7" Padding="11" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource WarningIcon}" Fill="{StaticResource WarningBrush}"
                      Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                <TextBlock Text="Nothing will be deleted until you press Apply Sync."
                           Foreground="{StaticResource WarningTextBrush}" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock x:Name="SummaryText" FontWeight="SemiBold" FontSize="12"/>
                <TextBlock x:Name="DeleteSummaryText" Foreground="{StaticResource DangerBrush}"
                           FontSize="12" Margin="12,0,0,0"/>
            </StackPanel>
            <DataGrid x:Name="ChangesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      RowHeight="30" FontSize="12" BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="1">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="100"/>
                    <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <Expander Grid.Row="2" Header="Show rclone preview output" FontSize="11" Margin="0,8,0,0">
                <ListBox x:Name="RawLinesList" Height="90" FontFamily="Consolas" FontSize="10"
                         BorderBrush="{StaticResource BorderBrush}"/>
            </Expander>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Style="{StaticResource SecondaryButton}" Click="Cancel_Click" Margin="0,0,8,0"
                    AutomationProperties.Name="Cancel sync preview">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource CancelIcon}" Style="{StaticResource ButtonIcon}"/>
                    <TextBlock Text="Cancel"/>
                </StackPanel>
            </Button>
            <Button x:Name="ConfirmButton" Style="{StaticResource DangerButton}" Click="Confirm_Click"
                    AutomationProperties.Name="Confirm sync and apply changes">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource CheckIcon}" Style="{StaticResource ButtonIcon}"/>
                    <TextBlock Text="Apply Sync"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
