<Window x:Class="RcloneTransferManager.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Rclone Transfer Manager" Width="520" Height="330"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Rclone Transfer Manager" FontSize="22" FontWeight="Bold"/>
            <TextBlock x:Name="VersionText" Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}"/>
            <TextBlock Text="Google Drive and public-link transfer utility for Windows."
                       Margin="0,12,0,0" TextWrapping="Wrap"/>
            <TextBlock Text="Updates are delivered securely through GitHub Releases."
                       Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <Button x:Name="CheckUpdatesButton" Style="{StaticResource PrimaryButton}"
                    Click="CheckUpdates_Click" HorizontalAlignment="Left">
                <TextBlock Text="Check for updates"/>
            </Button>
            <TextBlock x:Name="UpdateStatusText" Margin="0,10,0,0"
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
        </StackPanel>
        <Button Grid.Row="2" Style="{StaticResource SecondaryButton}" Click="Close_Click"
                HorizontalAlignment="Right"><TextBlock Text="Close"/></Button>
    </Grid>
</Window>
