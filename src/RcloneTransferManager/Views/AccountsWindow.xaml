<Window x:Class="RcloneTransferManager.Views.AccountsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Google Drive Account" Width="640" Height="390" MinWidth="540" MinHeight="350"
        WindowStartupLocation="CenterOwner" Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <Path Data="{StaticResource CloudIcon}" Style="{StaticResource SectionIcon}" Margin="0,0,9,0"/>
            <StackPanel>
                <TextBlock Text="Google Drive Account" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="Connect your Google Drive account; authorization opens in your browser."
                           Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Data="{StaticResource CloudIcon}" Style="{StaticResource SectionIcon}"
                          Width="22" Height="22" VerticalAlignment="Top" Margin="0,2,0,0"/>
                    <StackPanel Grid.Column="1" Margin="8,0,12,0">
                        <TextBlock Text="Google Drive" FontSize="15" FontWeight="Bold"/>
                        <TextBlock Text="Google Drive folder links" Foreground="{StaticResource MutedBrush}"
                                   FontSize="11" Margin="0,2,0,5"/>
                        <TextBlock x:Name="GoogleStatus" Text="Checking connection..." Foreground="{StaticResource MutedBrush}"
                                   FontSize="11" TextWrapping="Wrap"/>
                        <TextBlock x:Name="GoogleAccountIdentity" Text="" Foreground="{StaticResource ForegroundBrush}"
                                   FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="GoogleConnectButton" Style="{StaticResource PrimaryButton}"
                                Click="GoogleConnect_Click" Margin="0,0,6,0"
                                AutomationProperties.Name="Connect Google Drive">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource CloudIcon}" Style="{StaticResource ButtonIcon}"/>
                                <TextBlock Text="Connect"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="GoogleDisconnectButton" Style="{StaticResource SecondaryButton}"
                                Click="GoogleDisconnect_Click" IsEnabled="False"
                                AutomationProperties.Name="Disconnect Google Drive">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource CancelIcon}" Style="{StaticResource ButtonIcon}"/>
                                <TextBlock Text="Disconnect"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Background="{StaticResource NeutralSurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="7" Padding="11">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource InfoIcon}" Fill="{StaticResource PrimaryBrush}"
                          Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                    <TextBlock Text="Google Drive authorization is stored in your Windows AppData profile and survives app updates."
                               Foreground="{StaticResource ForegroundBrush}" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Style="{StaticResource SecondaryButton}" Click="Refresh_Click" Margin="0,0,8,0"
                    AutomationProperties.Name="Refresh Google Drive account status">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource RefreshIcon}" Style="{StaticResource ButtonIcon}"/>
                    <TextBlock Text="Refresh"/>
                </StackPanel>
            </Button>
            <Button x:Name="DoneButton" Style="{StaticResource PrimaryButton}" Click="Done_Click"
                    AutomationProperties.Name="Close Google Drive account">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource CheckIcon}" Style="{StaticResource ButtonIcon}"/>
                    <TextBlock Text="Done"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
