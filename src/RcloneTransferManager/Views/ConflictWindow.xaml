<Window x:Class="RcloneTransferManager.Views.ConflictWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review Copy Conflicts" Width="700" Height="500" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Path Data="{StaticResource CopyIcon}" Style="{StaticResource SectionIcon}" Margin="0,0,9,0"/>
            <StackPanel>
                <TextBlock Text="Review Copy Conflicts" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="Choose overwrite or skip for each changed destination file."
                           Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>
        <Border Grid.Row="1" Background="{StaticResource NeutralSurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="7" Padding="11" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource InfoIcon}" Fill="{StaticResource PrimaryBrush}"
                      Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                <TextBlock x:Name="SummaryText" Foreground="{StaticResource ForegroundBrush}" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <DataGrid x:Name="ConflictsGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="30"
                  FontSize="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="File path" Binding="{Binding Path}" Width="*"/>
                <DataGridComboBoxColumn Header="Decision" Width="150"
                    SelectedItemBinding="{Binding Decision, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    ItemsSource="{Binding DataContext.Decisions, RelativeSource={RelativeSource AncestorType=Window}}"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Style="{StaticResource SecondaryButton}" Click="Cancel_Click" Margin="0,0,8,0"
                    AutomationProperties.Name="Cancel copy conflict review">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource CancelIcon}" Style="{StaticResource ButtonIcon}"/>
                    <TextBlock Text="Cancel"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource PrimaryButton}" Click="Continue_Click"
                    AutomationProperties.Name="Continue copy with selected decisions">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource CheckIcon}" Style="{StaticResource ButtonIcon}"/>
                    <TextBlock Text="Continue Copy"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
