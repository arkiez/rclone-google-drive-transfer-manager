<Window x:Class="RcloneTransferManager.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rclone Transfer Manager Update" Width="620" Height="470"
        MinWidth="560" MinHeight="420" WindowStartupLocation="CenterOwner"
        Closing="UpdateWindow_Closing">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="New version available" FontSize="21" FontWeight="Bold"/>
            <TextBlock x:Name="VersionSummaryText" Margin="0,6,0,0"
                       Foreground="{StaticResource MutedBrush}"/>
        </StackPanel>
        <Border Grid.Row="1" Margin="0,16,0,14" Padding="12"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="Release notes" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBox Grid.Row="1" x:Name="ReleaseNotesText" IsReadOnly="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         BorderThickness="0" Background="Transparent"/>
            </Grid>
        </Border>
        <StackPanel Grid.Row="2">
            <TextBlock x:Name="DownloadStatusText" Foreground="{StaticResource MutedBrush}"/>
            <ProgressBar x:Name="DownloadProgress" Height="10" Margin="0,7,0,0"
                         Minimum="0" Maximum="100" Visibility="Collapsed"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="LaterButton" Style="{StaticResource SecondaryButton}" Click="Later_Click" Margin="0,0,8,0">
                <TextBlock Text="Later"/>
            </Button>
            <Button x:Name="UpdateNowButton" Style="{StaticResource PrimaryButton}" Click="UpdateNow_Click">
                <TextBlock Text="Update Now"/>
            </Button>
        </StackPanel>
    </Grid>
</Window>
